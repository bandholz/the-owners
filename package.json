{
  "name": "operators-the-owners-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Invite-only shared free/busy scheduler for Operators: The Owners",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "deploy:dry": "wrangler deploy --dry-run --outdir=dist-dry",
    "db:migrate:local": "wrangler d1 migrations apply operators-scheduler-local --local",
    "backup:dry": "tsx scripts/backup-d1.ts --dry-run",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251105.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true,
    "sharp@0.33.5": true
  }
}
