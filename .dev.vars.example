# Copy to .dev.vars for local wrangler dev. Never commit .dev.vars.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=replace-with-long-random-string
APP_BASE_URL=http://localhost:8787

# Access sync — leave disabled until Eric enables Access + provides app/policy ids
CF_ACCESS_SYNC_ENABLED=false
